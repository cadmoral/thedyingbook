  <metadata xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:opf="http://www.idpf.org/2007/opf">
    <dc:title id="id">The Dying Book</dc:title>
    <dc:creator id="id-1">Adrián Menéndez de la Cuesta G., Cristina Jiménez B., Carla del Moral S.</dc:creator>
    <dc:rights>©2017 Carla del Moral, Adrián Menéndez de la Cuesta G. and Cristina Jiménez B.</dc:rights>
